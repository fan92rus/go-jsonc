#!/bin/sh
set -e

echo "🔍 Running pre-commit checks..."
OUTFILE=$(mktemp /tmp/golangci-lint-out.XXXXXX 2>/dev/null || echo "/tmp/golangci-lint-out.$$")

# --- go vet (fastest, catches real bugs) ---
echo "  → go vet"
go vet ./... 2>&1 | sed 's/^/    /'
echo "  ✓ go vet passed"

# --- golangci-lint (if available) ---
if command -v golangci-lint >/dev/null 2>&1; then
    echo "  → golangci-lint"
    if golangci-lint run ./... > "$OUTFILE" 2>&1; then
        echo "  ✓ golangci-lint passed"
    else
        cat "$OUTFILE" | sed 's/^/    /'
        rm -f "$OUTFILE"
        echo "  ✗ golangci-lint found issues — commit blocked"
        exit 1
    fi
    rm -f "$OUTFILE"
else
    echo "  ⚠ golangci-lint not installed — skipping"
fi

# --- go test compile check ---
echo "  → go test (compile check)"
if ! go test -c -o /dev/null ./... 2>&1; then
    echo "  ✗ tests don't compile — commit blocked"
    exit 1
fi
echo "  ✓ tests compile"

echo "✅ All pre-commit checks passed!"
